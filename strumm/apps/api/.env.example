# MongoDB Database Connection
MONGODB_URI=*********************************************

# JWT Auth Secret
JWT_SECRET=*******************************************

# Hugging Face Inference API (AI recommendations, chat, smart playlists)
# Get your token: https://huggingface.co/settings/tokens
HF_API_KEY=hf_*************************************
HF_BASE_URL=https://api-inference.huggingface.co
HF_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B

# Server configuration
PORT=8000
HOST=0.0.0.0

# SMTP Configuration (For real OTP email dispatch using Google App Password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-gmail-address@gmail.com
SENDER_PASSWORD=your-google-app-password-here

# Sentry Error Monitoring
# Find your DSN at: https://sentry.io/settings/projects/ -> Client Keys (DSN)
SENTRY_DSN=your-backend-dsn-here
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=your-release-version

# --- Backblaze B2 Cloud Storage (private bucket) ---
# Create an application key at https://secure.backblaze.com/b2_buckets.htm
# with access only to the `strumm-media-prod` bucket. The key is server-side
# only; the frontend only ever receives short-lived presigned URLs.
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET_NAME=strumm-media-prod
# B2_KEY_ID=<your-application-key-id>
# B2_APPLICATION_KEY=<your-application-key-secret>

# --- Unused-media expiry (application-level, NOT object-age) ---
# A media object that has not been accessed (lastAccessedAt) for this many
# consecutive days and is no longer referenced (e.g. users.avatarMediaId) is
# eligible for deletion. Referenced media is NEVER deleted regardless of age.
MEDIA_UNUSED_RETENTION_DAYS=5
# How often the in-process cleanup loop runs (seconds; poll-only, min 300).
MEDIA_CLEANUP_INTERVAL_SECONDS=3600
# Set to "0" to disable the in-process loop (e.g. when an external cron owns
# cleanup); cleanup_expired_media() can still be invoked as a one-off job.
MEDIA_CLEANUP_ENABLED=1

# --- Frontend env vars (for reference) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_INVIDIOUS_INSTANCE=https://inv.nadeko.net
